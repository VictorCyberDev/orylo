# Orylo — environment template. Placeholders only; never commit real values.

# PostgreSQL (docker compose up -d db provides this locally)
DATABASE_URL=postgres://orylo:orylo@localhost:5432/orylo
# Used by integration tests (a separate database that tests may reset freely)
TEST_DATABASE_URL=postgres://orylo:orylo@localhost:5432/orylo_test

# Public base URL (used for auth callbacks, canonical URLs, sitemap)
APP_URL=http://localhost:3000

# Better Auth: generate with `openssl rand -base64 32`. REQUIRED in production. NOTE: `next start` runs in
# production mode and REFUSES placeholder values (change-me / dev-only) and anything under 32 chars — generate real
# random secrets before running `npm start` or the Playwright suite. `npm run dev` accepts the placeholders.
BETTER_AUTH_SECRET=change-me-dev-only-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# HMAC key used to sign action receipts and ledger entries. REQUIRED in production.
RECEIPT_SIGNING_KEY=change-me-dev-only-receipt-key

# Optional: email provider (not required; without it emails are recorded as SKIPPED, never "sent")
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=notifications@example.invalid

# Optional: eGain (all values placeholders; the live eGain agent runs on eGain's platform)
# EGAIN_TENANT_URL=
# EGAIN_ACTION_API_KEY_NOTE=Orylo issues API keys in Admin > API keys; paste into eGain connector, never here.

# Show demo credentials on /demo. Set to "false" in any shared/production deployment.
DEMO_MODE=true
# Gateway call timeout (ms) before an attempt is recorded as TIMEOUT and retried safely
ACTION_TIMEOUT_MS=5000
# Optional: path to a pre-installed Chromium for Playwright (CI installs its own)
# PW_CHROMIUM_PATH=

# --- Added by the hardening pass ---------------------------------------------------------------
# Evidence-at-rest key: base64 of 32 random bytes (`openssl rand -base64 32`). REQUIRED in production.
EVIDENCE_ENCRYPTION_KEY=
# Number of reverse proxies in front of the app that append to X-Forwarded-For. 0 = ignore forwarded headers
# (all callers then share one rate-limit bucket). Set to 1 behind exactly one trusted proxy/load balancer.
TRUSTED_PROXY_HOPS=0
# Optional: lets a platform scheduler call POST /api/internal/jobs/tick (Authorization: Bearer <secret>, >= 24 chars).
CRON_SECRET=
# Background worker: "off" disables the in-process worker (use `npm run worker` or the cron endpoint instead).
# JOB_WORKER=off
# JOB_POLL_MS=5000

# --- eGain chat widget (public configuration, NOT credentials; defaults are the owner's published agent) ---
# EGAIN_AGENT_ID=015f4f90-8772-4065-9e64-894b3615c5d3
# EGAIN_SERVER_URL=https://ai.egain.cloud/r9iv
# EGAIN_WIDGET=off                  # kill switch: removes the widget everywhere
# EGAIN_KNOWLEDGE_VERIFIED=true     # set ONLY after `npm run test:live` passes the knowledge cases (controls the honest /demo status panel)
# EGAIN_ACTIONS_LIVE=true           # set ONLY after eGain has been observed calling Orylo and changing the synthetic account

# --- public demo deployment (see docs/operations/vercel-deployment.md) ---
# JOB_WORKER=request                # serverless: no in-process timer; jobs drained by requests + the cron tick
# DB_POOL_MAX=3                     # serverless: keep per-instance pools small
# DEMO_PASSWORD=                    # REQUIRED to seed a public site (the repository default is public); >= 16 random chars
# REVIEWER_ACCESS_CODE=             # shared privately with organizers; reveals sign-in details on /demo
